# Names only. Never commit real values. Copy to .env.local for local development.
# Leave both empty to run guest-only (no accounts, progress on the device).
# Per environment (set in Vercel): Development -> local or staging Supabase,
# Preview -> staging Supabase project, Production -> production project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub Actions secrets (repository settings, not this file):
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
